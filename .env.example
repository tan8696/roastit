# ─── AI API Keys ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here          # optional, not currently used

# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# ─── Auth (NextAuth v5) ───────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000            # Change to your production URL
NEXTAUTH_SECRET=generate-a-long-random-secret-here

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Email (Feedback) ─────────────────────────────────────────────────────────
# Use a Gmail address with an App Password (NOT your regular password)
# Generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-app-password

# ─── Stripe ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Also powers email/password sign-in: NEXT_PUBLIC_SUPABASE_ANON_KEY verifies
# logins (auth.ts), SUPABASE_SERVICE_ROLE_KEY creates accounts (signup route).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...          # Project Settings → API → anon/public key
SUPABASE_SERVICE_ROLE_KEY=ey...              # Project Settings → API → service_role key (server-only, keep secret)

# ─── Google AdSense ───────────────────────────────────────────────────────────
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-0000000000000000
NEXT_PUBLIC_ADSENSE_SLOT_ID=1111111111
