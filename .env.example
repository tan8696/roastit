# ─── AI API Keys ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here          # optional, not currently used

# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# ─── Auth (NextAuth v5) ───────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000            # Change to your production URL
NEXTAUTH_SECRET=generate-a-long-random-secret-here

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Email (Feedback) ─────────────────────────────────────────────────────────
# Use a Gmail address with an App Password (NOT your regular password)
# Generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-app-password

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Also powers email/password sign-in: NEXT_PUBLIC_SUPABASE_ANON_KEY verifies
# logins (auth.ts), SUPABASE_SERVICE_ROLE_KEY creates accounts (signup route).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...          # Project Settings → API → anon/public key
SUPABASE_SERVICE_ROLE_KEY=ey...              # Project Settings → API → service_role key (server-only, keep secret)

# ─── Google AdSense ───────────────────────────────────────────────────────────
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-0000000000000000
NEXT_PUBLIC_ADSENSE_SLOT_ID=1111111111

# ─── Upstash Redis (rate limiting + roast caching) ────────────────────────────
# Optional — routes degrade gracefully (no rate limiting, no caching) if unset.
# Create a free database at https://console.upstash.com, then copy these from
# the database's REST API section.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ─── Google PageSpeed Insights (deterministic roast metrics) ──────────────────
# Optional — the roast still works with AI-only analysis if unset, just
# without real Lighthouse performance/accessibility/SEO scores. Enable the
# "PageSpeed Insights API" for a project at https://console.cloud.google.com,
# then create an API key restricted to that API (no billing required).
PAGESPEED_API_KEY=your-google-cloud-api-key
